# These values are optional. If not set, defaults will be used.
# See internal/config/config.go for default values.
# 1. Available: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG

# 2. Path to the conversation flow definition file
FLOW_FILE_PATH=./conversation.json

# 3. Path where the SQLite database file will be stored
SQLITE_DB_PATH=./store.db

# 4. Environment setting. Available: dev, prod. Default: prod
ENV=prod

# 5. Comma-separated list of users allowed to interact with the bot when ENV=dev.
# Ignored when ENV=prod.
# DEV_ALLOWED_USERS=XXXXXXXXXXX@s.whatsapp.net,YYYYYYYYYY@s.whatsapp.net
